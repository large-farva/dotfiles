{
  // ---------------------------------------------------------------------------
  // Agent
  // ---------------------------------------------------------------------------

  "cli_default_open_behavior": "existing_window",
  "agent": {
    "tool_permissions": {
      "tools": {
        "skill": {
          "default": "allow",
        },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^git\\b",
            },
          ],
        },
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com",
            },
            {
              "pattern": "^https?://blue-build\\.org",
            },
            {
              "pattern": "^https?://api\\.github\\.com",
            },
          ],
        },
      },
    },
    "sandbox_permissions": {
      "network_hosts": ["raw.githubusercontent.com", "api.github.com"],
    },

    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6-astra",
      "enable_thinking": true,
      "effort": "high",
    },

    "favorite_models": [],
    "model_parameters": [],

    "default_width": 700,
    "flexible": false,

    "threads_sidebar": {
      "auto_open": false,
    },
  },

  // ---------------------------------------------------------------------------
  // Context Servers
  // ---------------------------------------------------------------------------

  "context_servers": {
    "mcp-server-github": {
      "settings": {
        "github_personal_access_token": "<YOUR_GITHUB_TOKEN>",
      },
    },
  },

  // ---------------------------------------------------------------------------
  // Extensions
  // ---------------------------------------------------------------------------

  "auto_install_extensions": {
    "git-firefly": true,
    "toml": true,
    "material-icon-theme": true,
    "github-theme": true,
    "mcp-server-github": true,
    "editorconfig": true,
    "dockerfile": true,
    "sql": true,
    "log": true,
    "rainbow-csv": true,
    "python-requirements": true,
    "env": true,
    "just": true,
    "json5": true,
    "qml": true,
    "color-highlight": true,
  },

  // ---------------------------------------------------------------------------
  // Saving and Formatting
  // ---------------------------------------------------------------------------

  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },

  "format_on_save": "on",
  "close_on_file_delete": true,

  // ---------------------------------------------------------------------------
  // Editor
  // ---------------------------------------------------------------------------

  "code_lens": "on",
  "linked_edits": true,
  "lsp_document_colors": "inlay",

  "inlay_hints": {
    "enabled": true,
  },

  "cursor_animation": {
    "enabled": true,
  },

  "active_pane_modifiers": {
    "border_size": 0.2,
  },

  "semantic_tokens": "combined",
  "document_symbols": "on",
  "document_folding_ranges": "on",

  // ---------------------------------------------------------------------------
  // Tabs
  // ---------------------------------------------------------------------------

  "tabs": {
    "file_icons": true,
    "git_status": true,
  },

  // ---------------------------------------------------------------------------
  // Fonts
  // ---------------------------------------------------------------------------

  "buffer_font_family": "Cousine Nerd Font",
  "agent_buffer_font_family": "Cousine Nerd Font",
  "ui_font_family": "SF Pro Text",

  "buffer_font_size": 15.0,
  "buffer_font_weight": 400.0,
  "buffer_line_height": "comfortable",
  "ui_font_size": 15.0,

  // ---------------------------------------------------------------------------
  // Appearance
  // ---------------------------------------------------------------------------

  "icon_theme": "Material Icon Theme",

  "theme": {
    "mode": "system",
    "light": "GitHub Light",
    "dark": "GitHub Dark",
  },

  // ---------------------------------------------------------------------------
  // Languages
  // ---------------------------------------------------------------------------

  "languages": {
    "Go": {
      "formatter": "language_server",
      "format_on_save": "on",
      "semantic_tokens": "combined",
      "tab_size": 4,
      "hard_tabs": true,
    },

    "Rust": {
      "formatter": "language_server",
      "format_on_save": "on",
      "semantic_tokens": "combined",
      "tab_size": 4,
      "hard_tabs": false,
    },

    "Python": {
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },

      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },

      "format_on_save": "on",
      "semantic_tokens": "combined",
      "tab_size": 4,
      "hard_tabs": false,
      "preferred_line_length": 88,
    },

    "Shell Script": {
      "formatter": "language_server",
      "format_on_save": "on",
      "tab_size": 2,
      "hard_tabs": false,
    },

    "YAML": {
      "format_on_save": "on",
      "tab_size": 2,
      "hard_tabs": false,
      "preferred_line_length": 100,
    },

    "TOML": {
      "formatter": "language_server",
      "format_on_save": "on",
      "tab_size": 2,
      "hard_tabs": false,
    },

    "JSON": {
      "format_on_save": "on",
      "tab_size": 2,
      "hard_tabs": false,
    },

    "JSONC": {
      "format_on_save": "on",
      "tab_size": 2,
      "hard_tabs": false,
    },

    "JSON5": {
      "format_on_save": "on",
      "tab_size": 2,
      "hard_tabs": false,
    },

    "Dockerfile": {
      "format_on_save": "on",
      "tab_size": 2,
      "hard_tabs": false,
    },

    "Markdown": {
      "format_on_save": "off",
      "soft_wrap": "prefer_line",
      "preferred_line_length": 100,
      "tab_size": 2,
      "hard_tabs": false,
    },
  },

  // ---------------------------------------------------------------------------
  // Language Servers
  // ---------------------------------------------------------------------------

  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
      },
    },
  },
}
