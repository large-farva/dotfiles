# System configuration
if [[ -r /etc/bashrc ]]; then
    source /etc/bashrc
fi

# User binaries
for bin in "$HOME/bin" "$HOME/.local/bin"; do
    if [[ -d $bin && :$PATH: != *":$bin:"* ]]; then
        PATH="$bin:$PATH"
    fi
done
unset bin
export PATH

# Interactive shells only
[[ $- == *i* ]] || return

# Homebrew
if [[ -z ${HOMEBREW_PREFIX:-} ]]; then
    if command -v brew >/dev/null 2>&1; then
        brew_bin="$(command -v brew)"
    else
        for candidate in \
            "$HOME/.linuxbrew/bin/brew" \
            /home/linuxbrew/.linuxbrew/bin/brew; do
            if [[ -x $candidate ]]; then
                brew_bin=$candidate
                break
            fi
        done
        unset candidate
    fi

    if [[ -n ${brew_bin:-} ]]; then
        eval "$("$brew_bin" shellenv bash)"
        unset brew_bin
    fi
fi

# History
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth
HISTTIMEFORMAT='%F %T '
shopt -s histappend checkwinsize cmdhist cdspell

# Editor
if command -v micro >/dev/null 2>&1; then
    export EDITOR=micro
    export VISUAL=micro
fi

# Navigation
alias ..='cd ..'
alias ...='cd ../..'

# File listing
alias ll='ls -lh'
alias la='ls -lah'

if command -v eza >/dev/null 2>&1; then
    alias ls='eza --icons=auto --git'
    alias ll='eza --icons=auto --git -lh'
    alias la='eza --icons=auto --git -lah'
    alias lt='eza --icons=auto --tree --level=2'
fi

# System utilities
if command -v btop >/dev/null 2>&1; then
    alias top='btop'
fi

alias ports='ss -tulpn'

path() {
    printf '%s\n' "${PATH//:/$'\n'}"
}

if command -v rpm-ostree >/dev/null 2>&1; then
    alias deployments='rpm-ostree status'
fi

# Directory navigation
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
fi

# Additional Bash configuration
for rc in "$HOME"/.bashrc.d/*.sh; do
    [[ -f $rc && -r $rc ]] && source "$rc"
done
unset rc

# Prompt
if [[ ${TERM:-dumb} != dumb ]] &&
    ! declare -F starship_precmd >/dev/null &&
    command -v starship >/dev/null 2>&1; then
    if starship_init="$(starship init bash)"; then
        eval "$starship_init"
    fi
    unset starship_init
fi
